{
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/output/%RELATIVE_DIR%",
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.magic.args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "env": {"LC_ALL": "C"},
            "args": [
                "--input-directory=%OUTDIR%",
                "--output-directory=%OUTDIR%",
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX -> Biber -> XeLaTeX x2",
            "tools": ["xelatex", "biber", "xelatex", "xelatex"]
        },
        {
            "name": "XeLaTeX x2 (Beamer)",
            "tools": ["xelatex", "xelatex"]
        }
    ]
}
