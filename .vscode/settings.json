{
    "latex-workshop.view.pdf.viewer": "external",
    "latex-workshop.view.pdf.ref.viewer": "external",
    "latex-workshop.view.pdf.external.viewer.command": "D:\\App\\Foxit\\Foxit PDF Reader\\FoxitPDFReader.exe",
    "latex-workshop.view.pdf.external.viewer.args": ["%PDF%"],
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/%RELATIVE_DIR%",
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.magic.args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "publish-slide-pdf",
            "command": "python",
            "args": ["%WORKSPACE_FOLDER%/scripts/build_slides.py", "--publish-only"]
        },
        {
            "name": "biber",
            "command": "biber",
            "env": {"LC_ALL": "C"},
            "args": [
                "--input-directory=%OUTDIR%",
                "--output-directory=%OUTDIR%",
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX -> Biber -> XeLaTeX x2",
            "tools": ["xelatex", "biber", "xelatex", "xelatex"]
        },
        {
            "name": "XeLaTeX x2 (Beamer)",
            "tools": ["xelatex", "xelatex", "publish-slide-pdf"]
        }
    ]
}
